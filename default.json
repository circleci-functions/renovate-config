{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": true,
  "env": {
    "GOPRIVATE": "github.com/circleci-functions/*"
  },
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges",
    "abandonments:recommended",
    ":gomod",
    ":docker",
    ":separateMajorReleases"
  ],
  "schedule": ["* * * * 0"],
  "configMigration": true,
  "labels": ["renovate"],
  "vulnerabilityAlerts": {
    "addLabels": ["security"],
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "prHeader": "Some of your dependencies need to be updated.<br /><br />⚠️ **@circleci-functions/functions-maintainers are responsible for testing and merging these PRs.**<br /><br />ℹ️ Renovate [stops updating this branch when any edits are made](https://docs.renovatebot.com/updating-rebasing/#no-rebasing-if-you-have-made-edits), so if fixes are required to make the build pass, be sure to either merge this PR or rename then close it in a timely fashion to continue receiving Renovate updates.",
  "prFooter": "This PR was generated by the shared [circleci-functions/renovate-config](https://github.com/circleci-functions/renovate-config) configuration. Logs are available in [Renovate's dashboard](https://app.renovatebot.com/dashboard).",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/testdata/**",
    "**/internal/testing/**"
  ],
  "packageRules": [
    {
      "description": "In-org releases land immediately, in their own PR, rather than waiting for the weekly batch",
      "matchPackageNames": ["github.com/circleci-functions/**"],
      "minimumReleaseAge": "0 days",
      "schedule": ["at any time"]
    },
    {
      "description": "Bump the go directive in go.mod rather than widening a range",
      "matchDatasources": ["golang-version"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Keep the go directive and the cimg/go executor on the same toolchain",
      "groupName": "Go",
      "matchPackageNames": ["go", "cimg/go", "docker.io/library/golang"],
      "matchUpdateTypes": ["major", "minor", "patch"]
    },
    {
      "description": "One PR per week for everything else. Go and golangci-lint are excluded so toolchain and lint churn stay isolated.",
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "!go",
        "!cimg/go",
        "!docker.io/library/golang",
        "!github.com/golangci/golangci-lint/**",
        "!github.com/circleci-functions/**"
      ]
    },
    {
      "description": "Set sourceUrl for CircleCI orbs, so changelogs are included",
      "matchDatasources": ["orb"],
      "matchPackageNames": ["circleci/*"],
      "sourceUrl": "https://github.com/CircleCI-Public/{{ lookup (split packageName '/') 1 }}-orb"
    }
  ],
  "customManagers": [
    {
      "description": "Update versions using 'renovate: …' comments",
      "customType": "regex",
      "managerFilePatterns": ["**/*"],
      "matchStrings": [
        "\"(?<currentValue>[^\"]+)\"\\s+(?:#|//) renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: packageName=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\n",
        "\"(?<currentValue>[^\"]+)@(?<currentDigest>.+?)\"\\s+(?:#|//) renovate-digest: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: packageName=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\n",
        "'(?<currentValue>[^']+)'\\s+(?:#|//) renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: packageName=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\n",
        "'(?<currentValue>[^']+)@(?<currentDigest>.+?)'\\s+(?:#|//) renovate-digest: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: packageName=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\n"
      ]
    }
  ]
}
